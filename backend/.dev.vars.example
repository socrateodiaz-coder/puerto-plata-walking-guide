# Copy to .dev.vars and use sandbox/test credentials only. This example file
# is safe to commit; the copied file is ignored by Git.
APP_ENV=test
PAYMENTS_ENABLED=false
SITE_ORIGIN=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_WEBHOOK_SECRET
PAYPAL_CLIENT_ID=REPLACE_WITH_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=REPLACE_WITH_SANDBOX_WEBHOOK_ID
# Generate 32 random bytes and base64 encode them for local test config.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Supabase project URL is public configuration; keep the secret key only in
# the ignored .dev.vars file or Cloudflare Worker secrets, never in source.
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=puerto-plata-guide-private-test
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SIDE_SUPABASE_SECRET_KEY
